# Run npm run setup to generate a password. Never publish .env.local.
ADMIN_PASSWORD=
# Local single-server persistent storage. Optional absolute path:
# TIKI_DATA_FILE=/path/to/catalog.json
# Enable only behind HTTPS on a publicly hosted server:
COOKIE_SECURE=false
# Optional external services (not required for the catalogue):
ENABLE_AI=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ENABLE_FOOTBALL_SEARCH=false
RAPIDAPI_KEY=
